<Window x:Class="CapsCaret.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        WindowStartupLocation="Manual"
        Width="22"
        Height="20"

        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"

        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border
        x:Name="IndicatorBackground"
        CornerRadius="5"
        RenderTransformOrigin="0.5,0.5">

        <Border.RenderTransform>
            <ScaleTransform
                x:Name="IndicatorScale"
                ScaleX="1"
                ScaleY="1"/>
        </Border.RenderTransform>

        <Viewbox
            Width="13"
            Height="13"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Path
                x:Name="CapsIcon"
                Stretch="Uniform"
                Data="
                M 8,1
                L 14,7
                L 11,7
                L 11,12
                L 5,12
                L 5,7
                L 2,7
                Z

                M 5,14
                L 11,14
                L 11,16
                L 5,16
                Z" />

        </Viewbox>

    </Border>

</Window>