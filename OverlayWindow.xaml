<Window x:Class="CapsCaret.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Width="24"
        Height="24"

        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"

        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False">

    <Border
        Background="#DD202020"
        CornerRadius="6">

        <TextBlock
            Text="⇪"
            Foreground="White"
            FontSize="14"
            FontWeight="SemiBold"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

    </Border>

</Window>